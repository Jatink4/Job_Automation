

# ── Local Free AI (Ollama) ────────────────────────────────────────────────────
# Install Ollama from https://ollama.com (free, runs locally on your PC)
# Pull a free model: `ollama pull llama3.2` or `ollama run mistral`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ── Google Gemini API 
GEMINI_API_KEY=

# ── Application Behavior & Safety Caps ────────────────────────────────────────
# Maximum applications allowed per session
MAX_APPLICATIONS_PER_RUN=5

# Human simulation delays between operations (seconds)
DELAY_BETWEEN_APPS_MIN=45
DELAY_BETWEEN_APPS_MAX=90

# Default workflow: review_before_submit (True ensures no automatic submissions without your approval)
REVIEW_BEFORE_SUBMIT=True

# ── Telegram Notifications (Optional) ─────────────────────────────────────────
# Leave blank if you do not want Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Credentials (Optional — First-run manual login is recommended) ───────────
# It is recommended to log in manually via the visible browser window on first run.
# Your login session persists in browser_data/ (which is gitignored).
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
NAUKRI_EMAIL=
NAUKRI_PASSWORD=
